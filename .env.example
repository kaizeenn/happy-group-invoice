# Web server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://invoice.example.com

# MySQL (Docker Compose values use the service name mysql)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=happy_invoice
DB_USER=happy_invoice
DB_PASSWORD=replace-with-a-long-unique-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-root-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters

# Created once by npm run db:migrate. This account is promoted to Super Admin.
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=replace-with-a-strong-super-admin-password
# Optional standard admin seed for new installations.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
USER_USERNAME=user
USER_PASSWORD=replace-with-a-strong-user-password
